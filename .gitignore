# ==========================================
# Yii2 Project .gitignore
# ==========================================

# Dependencies
/vendor/
/node_modules/
/bower_components/


/config/db.php
/config/db-local.php
/config/params-local.php
/config/main-local.php

/console/config/*-local.php

# Yii2 runtime directories
/runtime/
/console/runtime/

# Generated assets
/web/assets/

# User uploaded files
/web/uploads/

# Local development files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log
logs/

# PHPUnit / testing
.phpunit.cache/
.phpunit.result.cache
/coverage/

# PHP caches
.phpunit-watcher.yml
.php-cs-fixer.cache
.phpactor.json

# Composer temporary files
composer.phar

# Node / frontend build cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.cache/
/dist/

# Local backups and archives
/backups/
*.sql
*.sql.gz
*.zip
*.tar
*.tar.gz

# Temporary files
/temp/
/tmp/